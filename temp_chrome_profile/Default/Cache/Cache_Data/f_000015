const __vite__css = "/* ==========================================================================\n   Traditional Maharashtra Mandi Billing Patti (मंडी पावती) Styling\n   M.A.B TRADERS, Solapur (APMC Commission Agent Billing)\n   Targeted for 8-inch (~203mm) Continuous Tractor-Feed Dot-Matrix Paper\n   ========================================================================== */\n\n/* Outer preview wrapper with desktop paper container */\n.mandi-patti-wrapper {\n  position: relative;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  width: 100%;\n  margin: 0 auto;\n  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.06);\n  border-radius: 4px;\n  background-color: #d1d5db;\n  padding: 8px 0;\n  transition: max-width 0.25s ease;\n  user-select: text;\n}\n\n/* Width modes in screen preview */\n.mandi-patti-wrapper.paper-standard-8in {\n  max-width: 580px; /* ~8 inches visual proportional scale on screen */\n}\n\n.mandi-patti-wrapper.paper-thermal-80mm {\n  max-width: 380px; /* 80mm roll visual scale on screen */\n}\n\n.mandi-patti-wrapper.paper-custom {\n  max-width: 600px;\n}\n\n/* Tractor-feed sprocket perforations for authentic continuous computer stationery */\n.tractor-feed-sprocket {\n  width: 16px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-around;\n  align-items: center;\n  padding: 12px 0;\n  background-color: #f7f6f0;\n  user-select: none;\n  flex-shrink: 0;\n}\n\n.sprocket-left {\n  border-top-left-radius: 4px;\n  border-bottom-left-radius: 4px;\n  border-right: 1px dashed #cbd5e1;\n}\n\n.sprocket-right {\n  border-top-right-radius: 4px;\n  border-bottom-right-radius: 4px;\n  border-left: 1px dashed #cbd5e1;\n}\n\n.sprocket-hole {\n  display: block;\n  width: 7.5px;\n  height: 7.5px;\n  border-radius: 50%;\n  background-color: #94a3b8;\n  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.4);\n  margin: 6px 0;\n}\n\n/* Hide sprockets in 80mm thermal roll mode */\n.paper-thermal-80mm .tractor-feed-sprocket {\n  display: none !important;\n}\n\n/* Main Printable Paper Surface */\n.mandi-receipt-printable {\n  position: relative;\n  width: 100%;\n  background-color: #fdfcf7; /* Warm authentic off-white Mandi Paper */\n  color: #0f172a;            /* Traditional Dark Navy / Charcoal */\n  font-family: 'Mukta', 'Noto Sans Devanagari', 'Segoe UI', Arial, sans-serif;\n  border-left: 1.5px dotted #9ca3af;\n  border-right: 1.5px dotted #9ca3af;\n  padding: 10px 12px 16px 12px;\n  box-sizing: border-box;\n  page-break-inside: avoid;\n  break-inside: avoid;\n}\n\n/* Compact spacing mode */\n.mandi-receipt-printable.spacing-compact {\n  padding: 6px 8px 10px 8px;\n}\n\n/* ==========================================================================\n   1. HEADER SECTION\n   Upper-Left Contacts + Centered Branding + Right Onion Graphic\n   ========================================================================== */\n.receipt-header-container {\n  margin-bottom: 5px;\n}\n\n/* Main Branding Row */\n.header-branding-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-top: 2px;\n  margin-bottom: 4px;\n  gap: 8px;\n}\n\n/* Upper-Left Section: 5 Business Contact Numbers */\n.header-contacts-left {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: flex-start;\n  gap: 1.5px;\n  width: 135px;\n  flex-shrink: 0;\n  text-align: left;\n  line-height: 1.25;\n}\n\n.header-contacts-left .contact-entry {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 3px;\n  white-space: nowrap;\n  font-size: 10px;\n}\n\n.header-contacts-left .contact-name {\n  color: #b91c1c;\n  font-weight: 800;\n  font-size: 10px;\n}\n\n.header-contacts-left .contact-num {\n  font-family: 'Consolas', 'Courier New', monospace;\n  font-weight: 700;\n  color: #0f172a;\n  font-size: 10.5px;\n  letter-spacing: 0.2px;\n}\n\n.branding-graphic-right {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 52px;\n  flex-shrink: 0;\n}\n\n.branding-center-block {\n  flex: 1;\n  text-align: center;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-width: 0;\n}\n\n.mab-center-seal {\n  margin-bottom: 1px;\n}\n\n.marathi-firm-name {\n  font-size: 25px;\n  font-weight: 900;\n  color: #b91c1c;\n  line-height: 1.1;\n  letter-spacing: 0.5px;\n  text-shadow: 0.5px 0.5px 0px rgba(0, 0, 0, 0.08);\n}\n\n.english-firm-name {\n  margin: 1px 0 2px 0;\n  font-family: 'Arial Black', Impact, sans-serif;\n  font-size: 23px;\n  font-weight: 900;\n  color: #15803d;\n  letter-spacing: 1.5px;\n  line-height: 1.05;\n}\n\n.firm-subtitle {\n  font-size: 10px;\n  font-weight: 700;\n  color: #166534;\n  line-height: 1.3;\n  margin: 1px 0;\n}\n\n.firm-address {\n  font-size: 9.5px;\n  font-weight: 600;\n  color: #374151;\n  line-height: 1.25;\n}\n\n/* ==========================================================================\n   2. RECEIPT METADATA (पावती क्र., दिनांक, मालधनीचे नांव, व.नं., गांव)\n   ========================================================================== */\n.receipt-metadata-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  margin-top: 5px;\n  margin-bottom: 6px;\n  padding: 4px 6px;\n  border-top: 1.5px solid #15803d;\n  border-bottom: 1.5px solid #15803d;\n  background-color: #faf8ef;\n}\n\n.meta-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  width: 100%;\n}\n\n.meta-cell {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n}\n\n.meta-cell.full-width {\n  width: 100%;\n}\n\n.meta-label {\n  font-size: 12px;\n  font-weight: 800;\n  color: #166534;\n  white-space: nowrap;\n}\n\n.meta-dots-wrap {\n  flex: 1;\n  display: flex;\n  align-items: baseline;\n}\n\n.meta-val {\n  font-size: 13px;\n  font-weight: 700;\n  color: #0f172a;\n}\n\n.receipt-number-badge {\n  font-family: 'Consolas', 'Courier New', monospace;\n  font-size: 14px;\n  font-weight: 900;\n  color: #b91c1c;\n  letter-spacing: 1px;\n}\n\n.farmer-name-bold {\n  font-size: 13.5px;\n  font-weight: 900;\n  color: #0f172a;\n  letter-spacing: 0.3px;\n}\n\n/* ==========================================================================\n   3. MAIN BILLING TABLE: UNBROKEN 58% / 42% SPLIT\n   Left (58%): Produce Lots + Blank Writing Area + Subtotal\n   Right (42%): 10 Standard APMC Mandi Deductions + Subtotal\n   ========================================================================== */\n.mandi-two-column-table {\n  display: flex;\n  width: 100%;\n  border: 1.5px solid #15803d;\n  background-color: #ffffff;\n  box-sizing: border-box;\n}\n\n/* ---------------- LEFT SECTION (ITEMS - 58%) ---------------- */\n.table-col-left-items {\n  flex: 0 0 58%;\n  border-right: 1.5px solid #15803d;\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n}\n\n/* Left Table Header */\n.items-header-bar {\n  display: flex;\n  border-bottom: 1.5px solid #15803d;\n  background-color: #f0fdf4;\n  font-weight: 800;\n  font-size: 11.5px;\n  color: #166534;\n  min-height: 36px;\n  align-items: stretch;\n}\n\n.items-header-bar .th-cell {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  border-right: 1px solid #15803d;\n  padding: 2px 3px;\n  box-sizing: border-box;\n}\n\n.items-header-bar .th-cell:last-child {\n  border-right: none;\n}\n\n/* Sub-column widths inside Left Section */\n.col-pishvi {\n  width: 15%;\n  flex-shrink: 0;\n  text-align: center !important;\n}\n\n.col-vajan {\n  width: 21%;\n  flex-shrink: 0;\n  text-align: right;\n  padding-right: 4px;\n}\n\n.col-bhav {\n  width: 21%;\n  flex-shrink: 0;\n  text-align: right;\n  padding-right: 4px;\n}\n\n.th-cell.col-ekun {\n  width: 43%;\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n  padding: 0 !important;\n  justify-content: stretch;\n}\n\n.ekun-title {\n  padding: 1px 0;\n  border-bottom: 1px solid #15803d;\n  width: 100%;\n  text-align: center;\n  font-weight: 800;\n}\n\n.ekun-sub {\n  display: flex;\n  width: 100%;\n  flex: 1;\n  font-size: 10.5px;\n}\n\n.sub-rupaye {\n  flex: 1;\n  border-right: 1px solid #15803d;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  white-space: nowrap;\n}\n\n.sub-paise {\n  width: 32px;\n  flex-shrink: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  white-space: nowrap;\n}\n\n/* Left Item Data Rows */\n.items-rows-container {\n  display: flex;\n  flex-direction: column;\n}\n\n.item-data-row {\n  display: flex;\n  border-bottom: none; /* NO GREEN DOTTED OR DASHED SEPARATOR LINES BETWEEN ITEMS */\n  min-height: 19px;\n  align-items: center;\n  font-size: 11.5px;\n  box-sizing: border-box;\n  line-height: 1.25;\n}\n\n.spacing-compact .item-data-row {\n  min-height: 17px;\n  font-size: 11px;\n}\n\n.item-data-row .td-cell {\n  padding: 1px 3px;\n  border-right: 1px solid #15803d;\n  box-sizing: border-box;\n}\n\n.item-data-row .td-cell:last-child {\n  border-right: none;\n}\n\n.td-cell.col-pishvi {\n  text-align: center;\n}\n\n.td-cell.col-vajan,\n.td-cell.col-bhav {\n  text-align: right;\n  padding-right: 4px;\n}\n\n.td-cell.col-ekun {\n  width: 43%;\n  flex-shrink: 0;\n  display: flex !important;\n  flex-direction: row !important;\n  align-items: baseline !important;\n  justify-content: flex-end !important;\n  padding: 1px 2px !important;\n  white-space: nowrap !important;\n  flex-wrap: nowrap !important;\n  box-sizing: border-box !important;\n  overflow: visible !important;\n}\n\n.amount-rupaye {\n  flex: 1;\n  text-align: right;\n  white-space: nowrap !important;\n  padding-right: 1px;\n  font-weight: 700;\n  color: #0f172a;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.amount-sep {\n  width: 4px;\n  flex-shrink: 0;\n  text-align: center;\n  font-weight: 700;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.amount-paise {\n  width: 27px;\n  flex-shrink: 0;\n  text-align: right;\n  padding-right: 2px;\n  font-weight: 700;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.empty-items-notice {\n  padding: 10px;\n  text-align: center;\n  font-style: italic;\n  color: #64748b;\n  font-size: 11px;\n}\n\n/* BLANK WRITING SPACE with Subtle Watermark */\n.blank-writing-area {\n  flex: 1;\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #faf9f5;\n  overflow: hidden;\n  transition: min-height 0.2s ease;\n}\n\n.blank-spacious {\n  min-height: 120px;\n}\n\n.blank-medium {\n  min-height: 60px;\n}\n\n.blank-minimized {\n  min-height: 16px;\n}\n\n.blank-zero {\n  min-height: 0px;\n  height: 0px;\n  padding: 0;\n  margin: 0;\n  overflow: hidden;\n}\n\n.faint-bg-watermark {\n  font-family: 'Arial Black', Impact, sans-serif;\n  font-size: 76px;\n  font-weight: 900;\n  color: #b91c1c;\n  opacity: 0.05;\n  transform: rotate(-25deg);\n  letter-spacing: 6px;\n  user-select: none;\n  pointer-events: none;\n}\n\n/* Left Subtotal Bar */\n.left-subtotal-bar {\n  display: flex;\n  border-top: 1.5px solid #15803d;\n  background-color: #f0fdf4;\n  font-size: 12px;\n  min-height: 27px;\n  align-items: center;\n  box-sizing: border-box;\n}\n\n.left-subtotal-bar .sub-cell {\n  padding: 3px;\n  border-right: 1px solid #15803d;\n  box-sizing: border-box;\n}\n\n.left-subtotal-bar .sub-cell:last-child {\n  border-right: none;\n}\n\n.left-subtotal-bar .col-ekun {\n  width: 43%;\n  flex-shrink: 0;\n  display: flex !important;\n  flex-direction: row !important;\n  align-items: baseline !important;\n  justify-content: flex-end !important;\n  padding: 2px 2px 2px 1px !important;\n  white-space: nowrap !important;\n  flex-wrap: nowrap !important;\n}\n\n.left-subtotal-bar .amount-rupaye {\n  flex: 1;\n  text-align: right;\n  white-space: nowrap !important;\n  padding-right: 1px;\n  font-weight: 800;\n  font-size: 12px;\n  line-height: 1.2;\n}\n\n.left-subtotal-bar .amount-sep {\n  width: 4px;\n  flex-shrink: 0;\n  text-align: center;\n  font-weight: 800;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 12px;\n  line-height: 1.2;\n}\n\n.left-subtotal-bar .amount-paise {\n  width: 27px;\n  flex-shrink: 0;\n  text-align: right;\n  padding-right: 2px;\n  font-weight: 800;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 12px;\n  line-height: 1.2;\n}\n\n.label-center {\n  text-align: center !important;\n  color: #166534;\n}\n\n/* ---------------- RIGHT SECTION (EXPENSES - 42%) ---------------- */\n.table-col-right-expenses {\n  flex: 0 0 42%;\n  display: flex;\n  flex-direction: column;\n  box-sizing: border-box;\n}\n\n/* Expense Header */\n.expenses-header-bar {\n  display: flex;\n  border-bottom: 1.5px solid #15803d;\n  background-color: #f0fdf4;\n  font-weight: 800;\n  font-size: 11.5px;\n  color: #166534;\n  min-height: 36px;\n  align-items: stretch;\n}\n\n.expenses-header-bar .th-cell {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2px 3px;\n  box-sizing: border-box;\n}\n\n.col-exp-name {\n  width: 53%;\n  flex-shrink: 0;\n  border-right: 1px solid #15803d;\n}\n\n.col-exp-amount {\n  width: 47%;\n  flex-shrink: 0;\n  display: flex;\n  justify-content: space-around;\n  align-items: center;\n  font-size: 10.5px;\n}\n\n/* 10 Standard APMC Mandi Deductions */\n.expenses-rows-container {\n  display: flex;\n  flex-direction: column;\n}\n\n.expense-row-item {\n  display: flex;\n  border-bottom: 1px solid #dcfce7;\n  min-height: 22px;\n  align-items: center;\n  font-size: 11.5px;\n  box-sizing: border-box;\n}\n\n.spacing-compact .expense-row-item {\n  min-height: 19.5px;\n  font-size: 11px;\n}\n\n.expense-row-item .td-cell {\n  padding: 1px 4px;\n  box-sizing: border-box;\n}\n\n.expense-row-item .col-exp-name {\n  width: 53%;\n  flex-shrink: 0;\n  border-right: 1px solid #15803d;\n  font-weight: 700;\n  color: #166534;\n  white-space: nowrap;\n}\n\n.expense-row-item .col-exp-amount {\n  width: 47%;\n  flex-shrink: 0;\n  text-align: right;\n  display: flex !important;\n  flex-direction: row !important;\n  align-items: baseline !important;\n  justify-content: flex-end !important;\n  padding: 1px 2px !important;\n  white-space: nowrap !important;\n  flex-wrap: nowrap !important;\n  overflow: visible !important;\n}\n\n.exp-rupaye {\n  flex: 1;\n  text-align: right;\n  white-space: nowrap !important;\n  padding-right: 1px;\n  font-weight: 700;\n  color: #0f172a;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.exp-sep {\n  width: 4px;\n  flex-shrink: 0;\n  text-align: center;\n  font-weight: 700;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.exp-paise {\n  width: 27px;\n  flex-shrink: 0;\n  text-align: right;\n  padding-right: 2px;\n  font-weight: 700;\n  color: #0f172a;\n  white-space: nowrap !important;\n  font-size: 11.5px;\n  line-height: 1.2;\n}\n\n.exp-zero {\n  color: #94a3b8 !important;\n  font-weight: 500;\n}\n\n/* Dynamic expenses spacer to preserve unbroken column divider when rows exceed 10 */\n.expenses-blank-spacer {\n  flex: 1;\n  display: flex;\n  min-height: 0;\n  width: 100%;\n  box-sizing: border-box;\n}\n\n.expenses-blank-spacer .spacer-cell.col-exp-name {\n  width: 53%;\n  flex-shrink: 0;\n  border-right: 1px solid #15803d;\n  box-sizing: border-box;\n}\n\n.expenses-blank-spacer .spacer-cell.col-exp-amount {\n  width: 47%;\n  flex-shrink: 0;\n  box-sizing: border-box;\n}\n\n/* Right Subtotal Bar */\n.right-subtotal-bar {\n  display: flex;\n  border-top: 1.5px solid #15803d;\n  background-color: #f0fdf4;\n  font-size: 12px;\n  min-height: 27px;\n  align-items: center;\n  box-sizing: border-box;\n  margin-top: auto; /* Aligns subtotal bar horizontally with left items subtotal */\n}\n\n.right-subtotal-bar .sub-cell {\n  padding: 3px;\n  box-sizing: border-box;\n}\n\n.right-subtotal-bar .col-exp-name {\n  width: 53%;\n  flex-shrink: 0;\n  border-right: 1px sol