PROJECT_NAME="M.A.B TRADERS Mandi Billing System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=mab_traders_db

# Security & CORS
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Mandi Standard Rates & Charges (Default config)
DEFAULT_COMMISSION_PERCENT=2.5
DEFAULT_MANDI_TAX_PERCENT=1.0
DEFAULT_DEVELOPMENT_CESS_PERCENT=0.5
DEFAULT_LABOUR_PER_BAG=10.0
DEFAULT_WEIGHING_PER_BAG=3.0
